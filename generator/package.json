{
  "name": "@rnt/frontend-generator",
  "version": "1.0.0",
  "description": "Frontend code generator for RNT Social API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "generate": "node dist/index.js",
    "generate:all": "node dist/index.js --all",
    "dev": "tsx src/index.ts",
    "add-types": "tsx src/utils/AddTypesToYaml.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0",
    "handlebars": "^4.7.8",
    "js-yaml": "^4.1.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "prettier": "^3.3.3",
    "glob": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.8.3",
    "tsx": "^4.19.2"
  }
}
