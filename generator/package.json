{
  "name": "@rnt/frontend-generator",
  "version": "2.0.0",
  "description": "Frontend code generator for RNT Social API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "generate": "node dist/index.js",
    "generate:all": "node dist/index.js generate:all",
    "dev": "tsx src/index.ts",
    "add-types": "tsx src/utils/AddTypesToYaml.ts"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fast-xml-parser": "^5.12.1",
    "handlebars": "^4.7.8",
    "js-yaml": "^4.1.0",
    "prettier": "^3.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "tsx": {
      "esbuild": "$esbuild"
    }
  }
}
