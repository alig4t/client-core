import type { BaseModel } from "@/core/models/BaseModel";
{{#each imports}}
{{#if this.isCore}}
import type { {{this.typeName}} } from "{{this.importPath}}";
{{else}}
import type { {{this.typeName}} } from "@/Models/{{this.entityName}}/{{this.typeName}}";
{{/if}}
{{/each}}

{{#if hasEnums}}
{{#each fields}}
{{#if this.enums}}
import type { {{../entityName}}{{pascalCase this.name}}Enum } from "./{{../entityName}}{{pascalCase this.name}}Enum";
{{/if}}
{{/each}}
{{/if}}

export interface {{entityName}}Model extends BaseModel {
{{#each fields}}
  {{this.name}}{{#unless this.required}}?{{/unless}}: {{#if this.enums}}{{../entityName}}{{pascalCase this.name}}Enum{{else}}{{getTsType this.type false}}{{/if}};
{{/each}}
{{#each relationships}}
{{#if (isToOne this.relationshipType)}}
  {{this.name}}{{#unless this.required}}?{{/unless}}: {{#if this.coreEntity}}{{this.relatedEntityName}}{{else}}{{this.relatedEntityName}}Model{{/if}};
{{/if}}
{{#if (isToMany this.relationshipType)}}
  {{this.name}}?: {{#if this.coreEntity}}{{this.relatedEntityName}}{{else}}{{this.relatedEntityName}}Model{{/if}}[];
{{/if}}
{{/each}}
}
