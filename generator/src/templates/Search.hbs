import React from "react";
import type { SubmitHandler } from "react-hook-form";
import { FormWrapper, type searchFilters } from "@/core/components/form/FormWrapper";
import { {{pascalCase entityName}}ModelMeta } from "./{{entityName}}Model.meta";
import FormInput from "@/core/components/form/FormInput";
import { DateInput } from "@/core/components/form/DateInput";
{{#if hasSearchableSelects}}
import { FormSelect } from "@/core/components/form/FormSelect";
{{/if}}
import Button from "@/core/components/general/button/Button";
import ButtonPanel from "@/core/components/general/button/ButtonPanel";
import { FilterOperator } from "@/core/forms/FilterOperators";
import { RowContainer } from "@/core/components/general/container/RowContainer";
import { PageWrapper } from "@/core/components/general/container/PageWrapper";
import { publicMessages, makeRangeLabel } from "@/core/forms/MessageUtils";
import z from "@/core/forms/zod.config";
import Validator from "@/core/forms/validation";
import OptionUtils from "@/core/forms/OptionUtils";

const searchSchema = z.object({
{{#each searchableFields}}
{{#if (eq this.type "STRING")}}
  [`{{this.name}}_${FilterOperator.LIKE}`]: Validator.optional(),
{{else if (or (eq this.type "INTEGER") (eq this.type "LONG") (eq this.type "DOUBLE"))}}
  [`{{this.name}}_${FilterOperator.GE}`]: Validator.optional(),
  [`{{this.name}}_${FilterOperator.LE}`]: Validator.optional(),
{{else if (or (eq this.type "DATE") (eq this.type "LOCAL_DATE") (eq this.type "LOCAL_DATE_TIME"))}}
  [`{{this.name}}_${FilterOperator.GE}`]: Validator.optional(),
  [`{{this.name}}_${FilterOperator.LE}`]: Validator.optional(),
{{else if (eq this.type "ENUM")}}
  [`{{this.name}}_${FilterOperator.EQ}`]: Validator.optional(),
{{else if (eq this.type "BOOLEAN")}}
  [`{{this.name}}_${FilterOperator.EQ}`]: Validator.optional(),
{{/if}}
{{/each}}
  // BaseModel fields
  [`createdAt_${FilterOperator.GE}`]: Validator.optional(),
  [`createdAt_${FilterOperator.LE}`]: Validator.optional(),
  [`updatedAt_${FilterOperator.GE}`]: Validator.optional(),
  [`updatedAt_${FilterOperator.LE}`]: Validator.optional(),
});

type SearchFormData = z.infer<typeof searchSchema>;

interface {{entityName}}SearchProps {
  onApplyFilters: (filters: searchFilters) => void;
}

const {{entityName}}Search: React.FC<{{entityName}}SearchProps> = ({ onApplyFilters }) => {
  const [formMethods, setFormMethods] = React.useState<any>(null);

  const onSubmit: SubmitHandler<SearchFormData> = (data) => {
    console.log(data);
    onApplyFilters(data);
  };

  const handleClear = () => {
    if (formMethods) {
      formMethods.reset();
    }
    onApplyFilters({});
  };

  return (
    <PageWrapper>
      <FormWrapper onSubmit={onSubmit} schema={searchSchema} onFormReady={setFormMethods}>
        <RowContainer>
{{#each searchableFields}}
{{#if (eq this.type "STRING")}}
          <FormInput
            name={`{{this.name}}_${FilterOperator.LIKE}`}
            label={ {{pascalCase ../entityName}}ModelMeta.fields.{{this.name}}?.label}
            placeholder="جستجو..."
          />
{{else if (eq this.type "ENUM")}}
          <FormSelect
            name={`{{this.name}}_${FilterOperator.EQ}`}
            label={ {{pascalCase ../entityName}}ModelMeta.fields.{{this.name}}?.label}
            placeholder="انتخاب کنید"
            options={ {{pascalCase ../entityName}}ModelMeta.fields.{{this.name}}.options || []}
          />
{{else if (eq this.type "BOOLEAN")}}
          <FormSelect
            name={`{{this.name}}_${FilterOperator.EQ}`}
            label={ {{pascalCase ../entityName}}ModelMeta.fields.{{this.name}}?.label}
            placeholder="انتخاب کنید"
            options={OptionUtils.YES_OR_NO_OPTIONS}
          />
{{else if (or (eq this.type "INTEGER") (eq this.type "LONG") (eq this.type "DOUBLE") (eq this.type "BIG_DECIMAL"))}}
          <FormInput
            name={`{{this.name}}_${FilterOperator.GE}`}
            label={ makeRangeLabel({{pascalCase ../entityName}}ModelMeta.fields.{{this.name}}?.label, "from") }
            type="{{lowercase this.type}}"
            placeholder={publicMessages.form.range.from}
          />
          <FormInput
            name={`{{this.name}}_${FilterOperator.LE}`}
            label={ makeRangeLabel({{pascalCase ../entityName}}ModelMeta.fields.{{this.name}}?.label, "to") }
            type="{{lowercase this.type}}"
            placeholder={publicMessages.form.range.to}
          />
{{else if (or (eq this.type "DATE") (eq this.type "LOCAL_DATE") (eq this.type "LOCAL_DATE_TIME"))}}
          <DateInput
            name={`{{this.name}}_${FilterOperator.GE}`}
            label={ makeRangeLabel({{pascalCase ../entityName}}ModelMeta.fields.{{this.name}}?.label, "from") }
          />
          <DateInput
            name={`{{this.name}}_${FilterOperator.LE}`}
            label={ makeRangeLabel({{pascalCase ../entityName}}ModelMeta.fields.{{this.name}}?.label, "to") }
          />
{{/if}}
{{/each}}

          {/* BaseModel fields: createdAt and updatedAt */}
          <DateInput
            name={`createdAt_${FilterOperator.GE}`}
            label={ makeRangeLabel({{pascalCase entityName}}ModelMeta.fields.createdAt.label, "from") }
          />
          <DateInput
            name={`createdAt_${FilterOperator.LE}`}
            label={ makeRangeLabel({{pascalCase entityName}}ModelMeta.fields.createdAt.label, "to") }
          />
          <DateInput
            name={`updatedAt_${FilterOperator.GE}`}
            label={ makeRangeLabel({{pascalCase entityName}}ModelMeta.fields.updatedAt.label, "from") }
          />
          <DateInput
            name={`updatedAt_${FilterOperator.LE}`}
            label={ makeRangeLabel({{pascalCase entityName}}ModelMeta.fields.updatedAt.label, "to") }
          />
        </RowContainer>

        <ButtonPanel align="start" className="mt-4">
          <Button variant="success" type="submit">
            {publicMessages.form.filters.apply}
          </Button>
          <Button variant="secondary" type="button" onClick={handleClear}>
            {publicMessages.form.filters.reset}
          </Button>
        </ButtonPanel>
      </FormWrapper>
    </PageWrapper>
  );
};

export default {{entityName}}Search;
