import React from "react";
import { useRouteMetadata } from "@/core/hooks/useRouteMetadata";
import { useBreadcrumbs } from "@/hooks/useBreadcrumbs";
import { useNavigate, useParams } from "react-router-dom";
import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
import { toast } from "sonner";
import { FormWrapper } from "@/core/components/form/FormWrapper";
import {{entityName}}Service from "./{{entityName}}Service";
import { {{pascalCase entityName}}ModelMeta } from "./{{entityName}}Model.meta";
import FormInput from "@/core/components/form/FormInput";
{{#if hasSelectFields}}
import { FormSelect } from "@/core/components/form/FormSelect";
{{/if}}
{{#if hasAutocompleteFields}}
import { FormAutoComplete } from "@/core/components/form/FormAutoComplete";
{{/if}}
{{#if hasDateFields}}
import { DateInput } from "@/core/components/form/DateInput";
{{/if}}
{{#if hasBooleanFields}}
import { Checkbox } from "@/core/components/form/Checkbox";
{{/if}}
import z from "@/core/forms/zod.config";
import Validator from "@/core/forms/validation";
import { RowContainer } from "@/core/components/general/container/RowContainer";
import Button from "@/core/components/general/button/Button";
import PageHeader from "@/core/components/general/container/PageHeader";
import Breadcrumb from "@/core/components/general/BreadCrumb";
import { PageWrapper } from "@/core/components/general/container/PageWrapper";
import PageTransition from "@/core/components/general/animation/PageTransition";
import CreatePagePlaceholder from "@/core/components/general/placeHolder/CreatePagePlaceholder";
import { VIEWNAME } from "@/router/ViewName";
import { getViewPath } from "@/core/router/RouteUtils";
import { publicMessages } from "@/core/forms/MessageUtils";
import { ReactQueryOptions } from "@/core/service/ReactQueryOptions";
import CreatePageFormWrapper from "@/core/components/general/container/CreateFormWrapper";
import ButtonPanel from "@/core/components/general/button/ButtonPanel";
{{#each relationshipServices}}
import {{this.serviceName}} from "@/Models/{{this.entityName}}/{{this.serviceName}}";
import { {{pascalCase this.entityName}}ModelMeta } from "@/Models/{{this.entityName}}/{{this.entityName}}Model.meta";
{{/each}}

const {{camelCase entityName}}Schema = z.object({
{{#each fields}}
{{#if this.required}}
  {{this.name}}: Validator.notNull(),
{{else}}
  {{this.name}}: Validator.optional(),
{{/if}}
{{/each}}
{{#each relationships}}
{{#if this.required}}
  {{this.name}}: Validator.notNull(),
{{else}}
  {{this.name}}: Validator.optional(),
{{/if}}
{{/each}}
});

type {{entityName}}FormData = z.infer<typeof {{camelCase entityName}}Schema>;

const {{entityName}}Create: React.FC = () => {
  const navigate = useNavigate();
  const { id } = useParams<{ id: string }>();
  const isEditMode = !!id;
  const routeMeta = useRouteMetadata();
  const queryClient = useQueryClient();

  const { data: existingData, isLoading } = useQuery({
    queryKey: ["{{camelCase entityName}}", id],
    queryFn: () => {{entityName}}Service.getById(Number(id!)),
    enabled: isEditMode,
    ...ReactQueryOptions.editOptions,
  });

  const mutation = useMutation({
    mutationFn: (data: {{entityName}}FormData) => {
      if (isEditMode) {
        return {{entityName}}Service.update(Number(id), data);
      }
      return {{entityName}}Service.create(data);
    },
    onSuccess: () => {
  toast.success(
    isEditMode
      ? {{pascalCase entityName}}ModelMeta.messages.update.success.title
      : {{pascalCase entityName}}ModelMeta.messages.create.success.title,
      {
        description: isEditMode
          ? {{pascalCase entityName}}ModelMeta.messages.update.success.description
          : {{pascalCase entityName}}ModelMeta.messages.create.success.description,
        position: "bottom-left",
      }
  );
  queryClient.invalidateQueries({ queryKey: ["{{camelCase entityName}}"] });
  navigate(getViewPath(VIEWNAME.{{snakeCase entityName}}_SEARCH));
},
    onError: () => {
      toast.error(
         isEditMode
      ? {{pascalCase entityName}}ModelMeta.messages.update.error.title
      : {{pascalCase entityName}}ModelMeta.messages.create.error.title,
      {
        description: isEditMode
          ? {{pascalCase entityName}}ModelMeta.messages.update.error.description
          : {{pascalCase entityName}}ModelMeta.messages.create.error.description,
        position: "bottom-left",
      }
        );
    },
  });

  const onSubmit = (data: {{entityName}}FormData) => {
    mutation.mutate(data);
  };

  const handleCancel = () => {
    navigate(getViewPath(VIEWNAME.{{snakeCase entityName}}_SEARCH));
  };

  const breadcrumbItems = useBreadcrumbs(
    isEditMode
      ? {{pascalCase entityName}}ModelMeta.messages.pageTitle.edit
      : {{pascalCase entityName}}ModelMeta.messages.pageTitle.create
  );

  if (isLoading && isEditMode) {
    return (
      <PageWrapper>
        <CreatePagePlaceholder rowCount={3} />
      </PageWrapper>
    );
  }

  return (
    
      <PageWrapper>
        <PageTransition>
          <Breadcrumb items={breadcrumbItems} className="mb-4" />
            <PageHeader
              title={
                isEditMode
                  ?  {{pascalCase entityName}}ModelMeta.messages.pageTitle.edit
                  :  {{pascalCase entityName}}ModelMeta.messages.pageTitle.create
              }
            />
            <CreatePageFormWrapper>
              <FormWrapper
                schema={ {{camelCase entityName}}Schema}
                onSubmit={onSubmit}
                defaultValues={existingData}
              >
                <RowContainer>
    {{#each fields}}
    {{#if (eq this.meta.type "text")}}
                  <FormInput
                    name="{{this.name}}"
                    label={ {{pascalCase ../entityName}}ModelMeta.fields.{{this.name}}.label}
                    placeholder={ {{pascalCase ../entityName}}ModelMeta.fields.{{this.name}}.placeholder}
    {{#if this.maxLength}}
                    maxLength={ {{this.maxLength}} }
    {{/if}}
                  />
    {{else if (eq this.meta.type "number")}}
                  <FormInput
                    name="{{this.name}}"
                    label={ {{pascalCase ../entityName}}ModelMeta.fields.{{this.name}}.label}
                    type="number"
                  />
    {{else if (eq this.meta.type "select")}}
                  <FormSelect
                    name="{{this.name}}"
                    label={ {{pascalCase ../entityName}}ModelMeta.fields.{{this.name}}.label}
                    options={ {{pascalCase ../entityName}}ModelMeta.fields.{{this.name}}.options || []}
                  />
    {{else if (eq this.meta.type "boolean")}}
                  <Checkbox
                    name="{{this.name}}"
                    label={ {{pascalCase ../entityName}}ModelMeta.fields.{{this.name}}.label}
                  />
    {{else if (or (eq this.meta.type "date") (eq this.meta.type "datetime-local"))}}
                  <DateInput
                    name="{{this.name}}"
                    label={ {{pascalCase ../entityName}}ModelMeta.fields.{{this.name}}.label}
                  />
    {{/if}}
    {{/each}}
    {{#each relationships}}
    {{#if (isToOne this.relationshipType)}}
                  <FormAutoComplete
                    name="{{this.name}}"
                    label={ {{pascalCase ../entityName}}ModelMeta.fields.{{this.name}}.label}
                    service={ {{this.relatedEntityName}}Service}
                    valueKey="id"
                    labelKey={ {{pascalCase this.relatedEntityName}}ModelMeta.displayField }
                  />
    {{/if}}
    {{#if (isToMany this.relationshipType)}}
                  <FormAutoComplete
                    name="{{this.name}}"
                    label={ {{pascalCase ../entityName}}ModelMeta.fields.{{this.name}}.label}
                    service={ {{this.relatedEntityName}}Service}
                    labelKey={ {{pascalCase this.relatedEntityName}}ModelMeta.displayField }
                    valueKey="id"
                    
                  />
    {{/if}}
    {{/each}}
                </RowContainer>

                  <ButtonPanel align="end">
                    <Button
                      type="button"
                      variant="secondary"
                      onClick={() => navigate(getViewPath(VIEWNAME.{{snakeCase entityName}}_SEARCH))}
                    >
                      {publicMessages.form.buttons.cancel}
                    </Button>
                    <Button type="submit" variant="primary" loading={mutation.isPending} disabled={mutation.isPending}>
                      {isEditMode 
                      ? publicMessages.form.buttons.update
                      : publicMessages.form.buttons.save}
                    </Button>
                  </ButtonPanel>
              
              </FormWrapper>
            </CreatePageFormWrapper>
        </PageTransition>
      </PageWrapper>

  );
};

export default {{entityName}}Create;
