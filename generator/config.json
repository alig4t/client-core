{
  "paths": {
    "entityDefinitions": "./entity-definitions",
    "outputBase": "../src/Models",
    "coreComponents": "../src/core",
    "menuConfig": "../menu-config.yaml",
    "routerOutput": "../src/router",
    "projectRoot": ".."
  },
  "generation": {
    "formatWithPrettier": true,
    "generateRoutes": true,
    "generatePermissions": true,
    "overwriteExisting": true,
    "typecheck": true
  },
  "coreEntities": {
    "User": {
      "isCore": true,
      "importPath": "@/Models/User/UserModel",
      "servicePath": "@/Models/User/UserService",
      "endpoint": "/auth/users",
      "displayField": "username"
    },
    "Role": {
      "isCore": true,
      "importPath": "@/Models/Role/RoleModel",
      "servicePath": "@/Models/Role/RoleService",
      "endpoint": "/role",
      "displayField": "name"
    },
    "Permission": {
      "isCore": true,
      "importPath": "@/Models/Permission/PermissionModel",
      "servicePath": "@/Models/Permission/PermissionService",
      "endpoint": "/permission",
      "displayField": "name"
    },
    "Attachment": {
      "isCore": true,
      "importPath": "@/Models/Attachment/AttachmentModel",
      "servicePath": "@/Models/Attachment/AttachmentService",
      "endpoint": "/attachment",
      "displayField": "id"
    }
  },
  "templates": {
    "Model": "./src/templates/Model.hbs",
    "ModelMeta": "./src/templates/ModelMeta.hbs",
    "Service": "./src/templates/Service.hbs",
    "Page": "./src/templates/Page.hbs",
    "Table": "./src/templates/Table.hbs",
    "TableColumns": "./src/templates/TableColumns.hbs",
    "Create": "./src/templates/Create.hbs",
    "Display": "./src/templates/Display.hbs",
    "Search": "./src/templates/Search.hbs",
    "ModuleRoutes": "./src/templates/ModuleRoutes.hbs",
    "ModuleViewNames": "./src/templates/ModuleViewNames.hbs"
  },
  "fieldTypeMapping": {
    "STRING": "string",
    "INTEGER": "number",
    "LONG": "string",
    "DOUBLE": "number",
    "BIG_DECIMAL": "string",
    "BOOLEAN": "boolean",
    "DATE": "string",
    "LOCAL_DATE": "string",
    "LOCAL_DATE_TIME": "string",
    "ENUM": "string"
  },
  "formTypeMapping": {
    "STRING": "text",
    "INTEGER": "number",
    "LONG": "long",
    "DOUBLE": "double",
    "BIG_DECIMAL": "bigDecimal",
    "BOOLEAN": "boolean",
    "DATE": "instant",
    "LOCAL_DATE": "date",
    "LOCAL_DATE_TIME": "datetime-local",
    "ENUM": "select"
  }
}
