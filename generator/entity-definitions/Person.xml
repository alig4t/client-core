<?xml version="1.0" encoding="UTF-8"?>
<entity>
    <name>Person</name>
    <generate>true</generate>
    <fields>
        <field>
            <name>firstName</name>
            <type>STRING</type>
            <required>true</required>
            <maxLength>100</maxLength>
        </field>
        <field>
            <name>lastName</name>
            <type>STRING</type>
            <required>true</required>
            <maxLength>100</maxLength>
        </field>
        <field>
            <name>nationalId</name>
            <type>STRING</type>
            <required>false</required>
            <maxLength>20</maxLength>
            <unique>true</unique>
        </field>
        <field>
            <name>birthDate</name>
            <type>DATE</type>
            <required>false</required>
        </field>
    </fields>
    <relationships>
        <relationship>
            <name>coreUser</name>
            <relationshipType>ONE_TO_ONE</relationshipType>
            <relatedEntityName>User</relatedEntityName>
            <coreUser>true</coreUser>
            <joinColumnName>core_user_id</joinColumnName>
            <required>true</required>
            <unique>true</unique>
            <fetch>LAZY</fetch>
        </relationship>
        <relationship>
            <name>city</name>
            <relationshipType>MANY_TO_ONE</relationshipType>
            <relatedEntityName>City</relatedEntityName>
            <joinColumnName>city_id</joinColumnName>
            <required>false</required>
            <fetch>LAZY</fetch>
        </relationship>
    </relationships>
</entity>