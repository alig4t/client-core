<?xml version="1.0" encoding="UTF-8"?>
<!-- User.xml -->

<entity>
    <name>User</name>
    <generate>true</generate>
    <fields>
        <field>
            <name>name</name>
            <type>STRING</type>
            <required>true</required>
            <maxLength>100</maxLength>
            <searchable>true</searchable>
        </field>
        <field>
            <name>username</name>
            <type>STRING</type>
            <required>true</required>
            <unique>true</unique>
            <maxLength>50</maxLength>
            <searchable>true</searchable>
        </field>
    </fields>
    <relationships>
        <relationship>
            <name>roles</name>
            <relationshipType>MANY_TO_MANY</relationshipType>
            <relatedEntityName>Role</relatedEntityName>
            <joinTableName>user_role</joinTableName>
        </relationship>
    </relationships>
</entity>