<?xml version="1.0" encoding="UTF-8"?>
<entity>
    <name>KeywordMatch</name>
    <generate>true</generate>
    <fields>
        <field>
            <name>matchedAt</name>
            <type>LOCAL_DATE_TIME</type>
            <required>true</required>
        </field>
    </fields>
    <relationships>
        <relationship>
            <name>message</name>
            <relationshipType>MANY_TO_ONE</relationshipType>
            <relatedEntityName>MessagingPlatform</relatedEntityName>
            <joinColumnName>message_id</joinColumnName>
            <required>true</required>
            <fetch>LAZY</fetch>
        </relationship>
        <relationship>
            <name>keyword</name>
            <relationshipType>MANY_TO_ONE</relationshipType>
            <relatedEntityName>Keyword</relatedEntityName>
            <joinColumnName>keyword_id</joinColumnName>
            <required>true</required>
            <fetch>LAZY</fetch>
        </relationship>
        <relationship>
            <name>coreUser</name>
            <relationshipType>MANY_TO_ONE</relationshipType>
            <relatedEntityName>User</relatedEntityName>
            <coreUser>true</coreUser>
            <joinColumnName>core_user_id</joinColumnName>
            <required>true</required>
            <fetch>LAZY</fetch>
        </relationship>
    </relationships>
</entity>
